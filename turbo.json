{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  // Files outside packages that can change any task's result. Over-including
  // only costs cache hits; missing one is a correctness bug.
  "globalDependencies": [
    ".babelrc.js",
    ".babelrc.build.js",
    ".nvmrc",
    ".prettierrc.json",
    ".prettierignore",
    "eslint.config.mjs",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "tsconfig.base.json"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    // Library packages. Build inputs leave out tests and docs, which the build
    // never reads, so editing a test doesn't rebuild every dependent package.
    "build:lib:esm": {
      "dependsOn": ["^build:lib:esm"],
      "inputs": ["$TURBO_DEFAULT$", "!src/**/*.test.*", "!*.md"],
      "outputs": ["es/**/*.js", "es/**/*.js.map"]
    },
    "build:lib:cjs": {
      "dependsOn": ["^build:lib:cjs"],
      "inputs": ["$TURBO_DEFAULT$", "!src/**/*.test.*", "!*.md"],
      "outputs": ["lib/**/*.js", "lib/**/*.js.map"]
    },
    "types:create": {
      "dependsOn": ["^types:create"],
      "inputs": ["$TURBO_DEFAULT$", "!src/**/*.test.*", "!*.md"],
      "outputs": [
        "es/**/*.d.ts",
        "es/**/*.d.ts.map",
        "lib/**/*.d.ts",
        "lib/**/*.d.ts.map"
      ]
    },
    // Aggregate (no script). Same inputs as above so that test edits don't
    // invalidate dependents' `^build`.
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "!src/**/*.test.*", "!*.md"],
      "dependsOn": ["build:lib:esm", "build:lib:cjs", "types:create"]
    },
    // Type-checks src including tests, against dependencies' built types.
    "types:check": {
      "dependsOn": ["types:create", "^types:create"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test/**"]
    },
    // Tests import dependencies through their built `lib`, plus the root
    // `test/` config and helpers (which import victory-vendor and
    // victory-voronoi).
    "jest": {
      "dependsOn": ["^build", "victory-vendor#build", "victory-voronoi#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test/**"]
    },
    // Packs the built package and checks it (publint, attw, loading every
    // entrypoint, and `pack-snapshot.json` where present). Loading needs the
    // dependencies' `lib`. Unlike the builds, Markdown is published.
    "pack:check": {
      "dependsOn": ["build", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/**/*.test.*",
        "$TURBO_ROOT$/scripts/pack-check.mjs"
      ]
    },
    // ESLint isn't type-aware and doesn't resolve imports, so it needs nothing built.
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    // Explicit globs don't apply .gitignore, so these mirror .prettierignore
    // (and leave out build output that other tasks write while this runs).
    "//#format": {
      "inputs": [
        "**/*.{js,jsx,mjs,cjs,json,ts,tsx}",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/{es,lib,lib-vendor,dist,build,coverage,storybook-static,.docusaurus,.cache}/**",
        "!packages/victory-vendor/{d3-*,internmap.js}"
      ]
    },
    "//#lint:root": {
      "inputs": [
        "*.js",
        "scripts/**",
        "stories/**",
        "test/**",
        "website/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!website/{build,.docusaurus}/**"
      ]
    },
    "//#lint:root:fix": {
      "cache": false
    }
  }
}

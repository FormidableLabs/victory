{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  // Files outside packages that can change any task's result. Over-including
  // only costs cache hits; missing one is a correctness bug.
  "globalDependencies": [
    ".nvmrc",
    ".prettierrc.json",
    ".prettierignore",
    "eslint.config.mjs",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "tsconfig.base.json",
    "tsdown.config.mts"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    // Library packages: tsdown (`tsdown.config.mts`) writes `dist/` (JS and
    // declarations), and also the `package.json` entry fields, which are
    // committed. Inputs leave out tests and docs, which the build never reads,
    // so editing a test doesn't rebuild every dependent package.
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!src/**/*.test.*", "!*.md"],
      "outputs": ["dist/**"]
    },
    // Type-checks src including tests, against dependencies' built types. Also
    // waits for the package's own build: the shared `test/` helpers import
    // victory-voronoi's source, which imports `victory-core` by package name.
    "types:check": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test/**"]
    },
    // Tests import dependencies through their built `dist`, plus the root
    // `test/` config and helpers (which import victory-vendor and
    // victory-voronoi).
    "test": {
      "dependsOn": ["^build", "victory-vendor#build", "victory-voronoi#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test/**"]
    },
    // Packs the built package and checks it (publint, attw, loading every
    // entrypoint, and `pack-snapshot.json` where present). Loading needs the
    // dependencies' `lib`. Unlike the builds, Markdown is published.
    "pack:check": {
      "dependsOn": ["build", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/**/*.test.*",
        "$TURBO_ROOT$/scripts/pack-check.mjs"
      ]
    },
    // ESLint isn't type-aware and doesn't resolve imports, so it needs nothing built.
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    // Explicit globs don't apply .gitignore, so these mirror .prettierignore
    // (and leave out build output that other tasks write while this runs).
    "//#format": {
      "inputs": [
        "**/*.{js,jsx,mjs,cjs,json,ts,tsx,mts,cts}",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/{es,lib,lib-vendor,dist,build,coverage,storybook-static,.docusaurus,.cache}/**",
        "!packages/victory-vendor/{d3-*,internmap.js}"
      ]
    },
    "//#lint:root": {
      "inputs": [
        "scripts/**",
        "stories/**",
        "test/**",
        "website/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!website/{build,.docusaurus}/**"
      ]
    },
    "//#lint:root:fix": {
      "cache": false
    }
  }
}

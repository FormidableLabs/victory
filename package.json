{
  "name": "victory-monorepo",
  "version": "0.0.0",
  "description": "Data viz for React",
  "keywords": [
    "data visualization",
    "React",
    "d3",
    "charting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/formidablelabs/victory.git"
  },
  "private": true,
  "author": "Formidable",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/formidablelabs/victory/issues"
  },
  "homepage": "https://commerce.nearform.com/open-source/victory",
  "packageManager": "pnpm@12.16.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^5.0.5",
    "d3-voronoi": "^1.1.4",
    "immutable": "^5.1.9",
    "jsdom": "^30.1.3",
    "lodash": "^4.18.1",
    "npm-check-updates": "^23.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rolldown": "~1.2.15",
    "seedrandom": "^3.0.5",
    "tsdown": "^0.23.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "scripts": {
    "version": "pnpm changeset version && pnpm install --no-frozen-lockfile",
    "changeset": "changeset",
    "start:docs": "turbo run build --filter=victory-docs^... && pnpm --filter victory-docs start",
    "check": "pnpm format && pnpm lint && turbo run test types:check",
    "check:debug": "pnpm format && pnpm lint && turbo run test types:check --concurrency=1",
    "dep:check": "ncu",
    "clean:build": "node scripts/clean.mjs coverage \"packages/*/{dist,es,lib}\"",
    "clean:cache": "pnpm clean:cache:turbo && pnpm clean:cache:modules",
    "clean:cache:turbo": "node scripts/clean.mjs .turbo \"packages/*/.turbo\" website/.turbo",
    "clean:cache:modules": "node scripts/clean.mjs node_modules/.cache \"packages/*/node_modules/.cache\"",
    "build": "turbo run build --filter=./packages/*",
    "build:docs": "turbo run build --filter=victory-docs",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --report-unused-disable-directives-severity=error --fix",
    "lint:gha": "node scripts/lint-gha.mjs",
    "test": "turbo run test",
    "test:coverage": "pnpm build && vitest run --config test/vitest.coverage.config.mts",
    "bundle-size": "pnpm build && node scripts/bundle-size.mjs",
    "types:check": "turbo run types:check",
    "pack:check": "turbo run pack:check --filter=./packages/*",
    "stories:dev": "turbo watch dev --filter=victory-stories",
    "stories:build": "turbo run build --filter=victory-stories",
    "stories:install": "pnpm --filter victory-stories exec playwright install chromium --only-shell",
    "stories:screenshots": "pnpm build && node scripts/stories-screenshots.mjs",
    "sync": "node scripts/sync-tsconfig.mjs"
  }
}

{
  "name": "victory-monorepo",
  "version": "0.0.0",
  "description": "Data viz for React",
  "keywords": [
    "data visualization",
    "React",
    "d3",
    "charting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/formidablelabs/victory.git"
  },
  "private": true,
  "author": "Formidable",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/formidablelabs/victory/issues"
  },
  "homepage": "https://commerce.nearform.com/open-source/victory",
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^3.2.2",
    "@storybook/addon-essentials": "^8.4.1",
    "@storybook/addon-storysource": "^8.4.1",
    "@storybook/addon-webpack5-compiler-swc": "1.0.5",
    "@storybook/react": "^8.4.1",
    "@storybook/react-webpack5": "^8.4.1",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^5.0.5",
    "chromatic": "^11.16.3",
    "concurrently": "^9.0.1",
    "cpx2": "^9.0.3",
    "immutable": "^5.1.9",
    "jsdom": "^30.1.3",
    "lodash": "^4.18.1",
    "npm-check-updates": "^23.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "rolldown": "~1.2.15",
    "seedrandom": "^3.0.5",
    "storybook": "^8.4.1",
    "tsdown": "^0.23.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "scripts": {
    "version": "pnpm changeset version && pnpm install --no-frozen-lockfile",
    "changeset": "changeset",
    "start:docs": "turbo run build --filter=victory-docs^... && pnpm --filter victory-docs start",
    "check": "pnpm format && pnpm lint && turbo run test types:check",
    "check:debug": "pnpm format && pnpm lint && turbo run test types:check --concurrency=1",
    "dep:check": "ncu",
    "clean:build": "rimraf --glob coverage \"packages/*/{dist,es,lib}\"",
    "clean:cache": "pnpm clean:cache:turbo && pnpm clean:cache:modules",
    "clean:cache:turbo": "rimraf --glob .turbo \"packages/*/.turbo\" website/.turbo",
    "clean:cache:modules": "rimraf --glob node_modules/.cache \"packages/*/node_modules/.cache\"",
    "build": "turbo run build --filter=./packages/*",
    "build:docs": "turbo run build --filter=victory-docs",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --report-unused-disable-directives-severity=error --fix",
    "lint:gha": "node scripts/lint-gha.mjs",
    "test": "turbo run test",
    "test:coverage": "pnpm build && vitest run --config test/vitest.coverage.config.mts",
    "bundle-size": "pnpm build && node scripts/bundle-size.mjs",
    "types:check": "turbo run types:check",
    "pack:check": "turbo run pack:check --filter=./packages/*",
    "build-storybook": "storybook build",
    "storybook:typecheck": "tsc -p tsconfig.storybook.json",
    "storybook:build": "pnpm build && storybook build",
    "storybook:dev": "concurrently --raw \"turbo watch build --filter=./packages/*\" \"pnpx storybook dev -p 6006\"",
    "storybook:start": "storybook dev -p 6006 --no-open",
    "sync": "pnpm -r --filter !victory-core --filter !victory-vendor exec -- cpx ../victory-core/tsconfig.* ."
  }
}

{
  "name": "victory-monorepo",
  "version": "0.0.0",
  "description": "Data viz for React",
  "keywords": [
    "data visualization",
    "React",
    "d3",
    "charting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/formidablelabs/victory.git"
  },
  "private": true,
  "author": "Formidable",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/formidablelabs/victory/issues"
  },
  "homepage": "https://commerce.nearform.com/open-source/victory",
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@babel/cli": "7.23.9",
    "@babel/core": "7.23.9",
    "@babel/plugin-transform-export-namespace-from": "7.23.4",
    "@babel/plugin-transform-modules-commonjs": "7.23.3",
    "@babel/preset-env": "7.23.9",
    "@babel/preset-react": "7.23.3",
    "@babel/preset-typescript": "7.23.3",
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^3.2.2",
    "@eslint/js": "^9.14.0",
    "@storybook/addon-essentials": "^8.4.1",
    "@storybook/addon-storysource": "^8.4.1",
    "@storybook/addon-webpack5-compiler-swc": "1.0.5",
    "@storybook/react": "^8.4.1",
    "@storybook/react-webpack5": "^8.4.1",
    "@svitejs/changesets-changelog-github-compact": "^0.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/fs-extra": "^11.0.3",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.14.149",
    "@types/node": "^18.6.1",
    "@types/prop-types": "^15.7.5",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "babel-jest": "29.7.0",
    "babel-loader": "9.1.3",
    "babel-plugin-module-resolver": "5.0.0",
    "chromatic": "^11.16.3",
    "concurrently": "^9.0.1",
    "cpx2": "^4.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "fs-extra": "^10.0.0",
    "glob": "8.0.3",
    "globals": "^15.12.0",
    "immutable": "^3.8.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lodash": "^4.17.19",
    "lodash-webpack-plugin": "^0.11.6",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-hot-loader": "4.13.0",
    "react-icons": "^5.3.0",
    "react-test-renderer": "^18.1.0",
    "rimraf": "^3.0.2",
    "seedrandom": "^3.0.5",
    "storybook": "^8.4.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.3.0",
    "ts-node": "^10.9.1",
    "turbo": "^2.11.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.13.0",
    "victory-vendor": "*",
    "victory-voronoi": "*",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.9.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "scripts": {
    "version": "pnpm changeset version && pnpm install --no-frozen-lockfile",
    "changeset": "changeset",
    "start": "webpack serve --config ./config/webpack/demo/webpack.config.dev.js --static demo/ts --entry ./demo/ts/app",
    "start:docs": "turbo run build:lib:esm --filter=victory-docs^... && pnpm --filter victory-docs start",
    "check": "turbo run format lint:root lint jest types:check",
    "check:debug": "turbo run format lint:root lint jest types:check --concurrency=1",
    "clean:build": "rimraf coverage \"packages/*/{dist,es,lib}\"",
    "clean:cache": "pnpm clean:cache:turbo && pnpm clean:cache:lint && pnpm clean:cache:modules",
    "clean:cache:lint": "rimraf .eslintcache node_modules/.cache/eslint node_modules/.cache/prettier \"packages/*/node_modules/.cache/eslint\"",
    "clean:cache:turbo": "rimraf .turbo \"packages/*/.turbo\" website/.turbo",
    "clean:cache:modules": "rimraf node_modules/.cache \"packages/*/node_modules/.cache\"",
    "build": "turbo run build --filter=./packages/*",
    "build:lib:esm": "turbo run build:lib:esm --filter=./packages/*",
    "build:typescript": "turbo run build:lib:esm types:create --filter=./packages/*",
    "build:docs": "turbo run build --filter=victory-docs",
    "format": "prettier --config .prettierrc.json --ignore-path .prettierignore --cache --cache-location node_modules/.cache/prettier/.prettier-cache --check \"./**/*.{js,jsx,json,ts,tsx}\"",
    "format:fix": "prettier --config .prettierrc.json --ignore-path .prettierignore --cache --cache-location node_modules/.cache/prettier/.prettier-cache --write \"./**/*.{js,jsx,json,ts,tsx}\"",
    "lint": "turbo run lint:root lint",
    "lint:fix": "turbo run lint:root:fix lint:fix",
    "lint:root": "eslint --color --cache --cache-location node_modules/.cache/eslint/ *.js scripts config stories test website",
    "lint:root:fix": "eslint --color --cache --cache-location node_modules/.cache/eslint/ --fix *.js scripts config stories test website",
    "lint:pkgs": "turbo run lint",
    "lint:pkgs:fix": "turbo run lint:fix",
    "jest": "turbo run jest",
    "types:check": "turbo run types:check",
    "types:create": "turbo run types:create --filter=./packages/*",
    "build-storybook": "storybook build",
    "storybook:typecheck": "tsc -p tsconfig.storybook.json",
    "storybook:build": "pnpm build:lib:esm && storybook build",
    "storybook:dev": "concurrently --raw \"turbo watch build:lib:esm --filter=./packages/*\" \"pnpx storybook dev -p 6006\"",
    "storybook:start": "storybook dev -p 6006 --no-open",
    "sync": "pnpm -r --filter !victory-core --filter !victory-vendor exec -- cpx ../victory-core/tsconfig.* ."
  }
}

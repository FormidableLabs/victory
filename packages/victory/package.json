{
  "name": "victory",
  "version": "38.1.0",
  "description": "Data viz for React",
  "keywords": [
    "data visualization",
    "React",
    "d3",
    "charting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FormidableLabs/victory"
  },
  "homepage": "https://commerce.nearform.com/open-source/victory",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "author": "Formidable",
  "license": "MIT",
  "dependencies": {
    "victory-area": "38.1.0",
    "victory-axis": "38.1.0",
    "victory-bar": "38.1.0",
    "victory-box-plot": "38.1.0",
    "victory-brush-container": "38.1.0",
    "victory-brush-line": "38.1.0",
    "victory-candlestick": "38.1.0",
    "victory-canvas": "38.1.0",
    "victory-chart": "38.1.0",
    "victory-core": "38.1.0",
    "victory-create-container": "38.1.0",
    "victory-cursor-container": "38.1.0",
    "victory-errorbar": "38.1.0",
    "victory-group": "38.1.0",
    "victory-histogram": "38.1.0",
    "victory-legend": "38.1.0",
    "victory-line": "38.1.0",
    "victory-pie": "38.1.0",
    "victory-polar-axis": "38.1.0",
    "victory-scatter": "38.1.0",
    "victory-selection-container": "38.1.0",
    "victory-shared-events": "38.1.0",
    "victory-stack": "38.1.0",
    "victory-tooltip": "38.1.0",
    "victory-voronoi": "38.1.0",
    "victory-voronoi-container": "38.1.0",
    "victory-zoom-container": "38.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "react": "^19.3.1"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.mts",
    "types:check": "tsc --pretty --noEmit",
    "test": "vitest run --config ../../test/vitest.config.mts --passWithNoTests",
    "pack:check": "node ../../scripts/pack-check.mjs"
  }
}

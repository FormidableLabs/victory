{
  "name": "victory",
  "version": "37.4.1",
  "description": "Data viz for React",
  "keywords": [
    "data visualization",
    "React",
    "d3",
    "charting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FormidableLabs/victory"
  },
  "homepage": "https://commerce.nearform.com/open-source/victory",
  "source": "src/index.ts",
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "es/index.js",
  "jsnext:main": "es/index.js",
  "author": "Formidable",
  "license": "MIT",
  "dependencies": {
    "victory-area": "37.4.1",
    "victory-axis": "37.4.1",
    "victory-bar": "37.4.1",
    "victory-box-plot": "37.4.1",
    "victory-brush-container": "37.4.1",
    "victory-brush-line": "37.4.1",
    "victory-candlestick": "37.4.1",
    "victory-canvas": "37.4.1",
    "victory-chart": "37.4.1",
    "victory-core": "37.4.1",
    "victory-create-container": "37.4.1",
    "victory-cursor-container": "37.4.1",
    "victory-errorbar": "37.4.1",
    "victory-group": "37.4.1",
    "victory-histogram": "37.4.1",
    "victory-legend": "37.4.1",
    "victory-line": "37.4.1",
    "victory-pie": "37.4.1",
    "victory-polar-axis": "37.4.1",
    "victory-scatter": "37.4.1",
    "victory-selection-container": "37.4.1",
    "victory-shared-events": "37.4.1",
    "victory-stack": "37.4.1",
    "victory-tooltip": "37.4.1",
    "victory-voronoi": "37.4.1",
    "victory-voronoi-container": "37.4.1",
    "victory-zoom-container": "37.4.1"
  },
  "peerDependencies": {
    "react": ">=16.6.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build:lib:esm": "cross-env BABEL_ENV=es babel src --out-dir es --config-file ../../.babelrc.build.js --extensions .tsx,.ts,.jsx,.js",
    "build:lib:cjs": "cross-env BABEL_ENV=commonjs babel src --out-dir lib --config-file ../../.babelrc.build.js --extensions .tsx,.ts,.jsx,.js",
    "build:dist:dev": "webpack --bail --config ../../config/webpack/webpack.config.dev.js",
    "build:dist:min": "webpack --bail --config ../../config/webpack/webpack.config.js",
    "types:check": "tsc --pretty --noEmit",
    "types:create": "cpx \"src/**/*.d.ts\" es && (tsc --pretty -p ./tsconfig.build.json --emitDeclarationOnly --rootDir src --outDir es || echo \"Warning: found TypeScript errors during build. Continuing anyway!\") && cpx \"es/**/*{.d.ts,.d.ts.map}\" lib",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ src",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix src",
    "jest": "jest --passWithNoTests"
  }
}

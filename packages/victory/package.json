{
  "name": "victory",
  "version": "37.4.1",
  "description": "Data viz for React",
  "keywords": [
    "data visualization",
    "React",
    "d3",
    "charting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FormidableLabs/victory"
  },
  "homepage": "https://commerce.nearform.com/open-source/victory",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "author": "Formidable",
  "license": "MIT",
  "dependencies": {
    "victory-area": "37.4.1",
    "victory-axis": "37.4.1",
    "victory-bar": "37.4.1",
    "victory-box-plot": "37.4.1",
    "victory-brush-container": "37.4.1",
    "victory-brush-line": "37.4.1",
    "victory-candlestick": "37.4.1",
    "victory-canvas": "37.4.1",
    "victory-chart": "37.4.1",
    "victory-core": "37.4.1",
    "victory-create-container": "37.4.1",
    "victory-cursor-container": "37.4.1",
    "victory-errorbar": "37.4.1",
    "victory-group": "37.4.1",
    "victory-histogram": "37.4.1",
    "victory-legend": "37.4.1",
    "victory-line": "37.4.1",
    "victory-pie": "37.4.1",
    "victory-polar-axis": "37.4.1",
    "victory-scatter": "37.4.1",
    "victory-selection-container": "37.4.1",
    "victory-shared-events": "37.4.1",
    "victory-stack": "37.4.1",
    "victory-tooltip": "37.4.1",
    "victory-voronoi": "37.4.1",
    "victory-voronoi-container": "37.4.1",
    "victory-zoom-container": "37.4.1"
  },
  "peerDependencies": {
    "react": ">=16.6.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.mts",
    "types:check": "tsc --pretty --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ src",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix src",
    "jest": "jest --passWithNoTests",
    "pack:check": "node ../../scripts/pack-check.mjs"
  }
}

{
  "name": "victory-canvas",
  "version": "37.4.1",
  "description": "HTML5 Canvas Components for Victory",
  "keywords": [
    "data visualization",
    "React",
    "d3",
    "charting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FormidableLabs/victory"
  },
  "homepage": "https://commerce.nearform.com/open-source/victory",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "author": "Formidable",
  "license": "MIT",
  "dependencies": {
    "victory-bar": "37.4.1",
    "victory-core": "37.4.1"
  },
  "peerDependencies": {
    "react": ">=16.6.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.mts",
    "types:check": "tsc --pretty --noEmit",
    "test": "vitest run --config ../../test/vitest.config.mts --passWithNoTests",
    "pack:check": "node ../../scripts/pack-check.mjs"
  }
}

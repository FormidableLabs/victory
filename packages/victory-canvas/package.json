{
  "name": "victory-canvas",
  "version": "37.4.1",
  "description": "HTML5 Canvas Components for Victory",
  "keywords": [
    "data visualization",
    "React",
    "d3",
    "charting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FormidableLabs/victory"
  },
  "homepage": "https://commerce.nearform.com/open-source/victory",
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "es/index.js",
  "jsnext:main": "es/index.js",
  "author": "Formidable",
  "license": "MIT",
  "dependencies": {
    "lodash": "^4.17.19",
    "victory-bar": "37.4.1",
    "victory-core": "37.4.1"
  },
  "peerDependencies": {
    "react": ">=16.6.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build:lib:esm": "cross-env BABEL_ENV=es babel src --out-dir es --config-file ../../.babelrc.build.js --extensions .tsx,.ts,.jsx,.js",
    "build:lib:cjs": "cross-env BABEL_ENV=commonjs babel src --out-dir lib --config-file ../../.babelrc.build.js --extensions .tsx,.ts,.jsx,.js",
    "build:dist:dev": "webpack --bail --config ../../config/webpack/webpack.config.dev.js",
    "build:dist:min": "webpack --bail --config ../../config/webpack/webpack.config.js",
    "types:check": "tsc --pretty --noEmit",
    "types:create": "cpx \"src/**/*.d.ts\" es && (tsc --pretty -p ./tsconfig.build.json --emitDeclarationOnly --rootDir src --outDir es || echo \"Warning: found TypeScript errors during build. Continuing anyway!\") && cpx \"es/**/*{.d.ts,.d.ts.map}\" lib",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ src",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix src",
    "jest": "jest --passWithNoTests",
    "pack:check": "node ../../scripts/pack-check.mjs"
  }
}

{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TS 6 deprecates `baseUrl`. Unset the inherited one and redeclare
    // `paths`, which then resolves relative to this file. (`tsc --showConfig`
    // still prints a `baseUrl`; resolution doesn't use it.)
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    },
    // TS 6 defaults this to `true`. The site was never strict.
    "strict": false,
    "types": [
      "@docusaurus/module-type-aliases",
      "@docusaurus/theme-classic",
      "@docusaurus/theme-live-codeblock"
    ]
  },
  "include": ["vendors.d.ts", "src"]
}

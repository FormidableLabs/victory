{
  "$schema": "../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    // Docusaurus bundles Victory's built packages. Not cached: Vercel builds
    // from scratch, and Docusaurus has its own cache.
    "build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // No `types:check` script here. Without this, the root definition's
    // `dependsOn: ["build"]` would run the docs build during `pnpm check`.
    "types:check": {
      "dependsOn": []
    }
  }
}

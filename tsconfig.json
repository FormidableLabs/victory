{
  "compilerOptions": {
    // Matches `target` in tsdown.config.mts.
    "target": "ES2022",
    // Class fields are assigned in the constructor, so type-only fields
    // aren't emitted (as with the old Babel build). ES2022 would otherwise
    // default this to `true`.
    "useDefineForClassFields": false,
    "module": "esnext",
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "strict": true,        
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "esModuleInterop": true,              
    "skipLibCheck": true,                 
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "dom", 
      "dom.iterable", 
      "esnext"
    ],
    "paths": {
      "@/*": ["./packages/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest"],
  },
}
